<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>x64</PlatformTarget>
		<ImplicitUsings>true</ImplicitUsings>
		<PublishAddinFiles>true</PublishAddinFiles>
		<Configurations>Debug R20;Debug R21;Debug R22;Debug R23;Debug R24;Debug R25;Debug R26;Debug R27</Configurations>
		<Configurations>$(Configurations);Release R20;Release R21;Release R22;Release R23;Release R24;Release R25;Release R26;Release R27</Configurations>
		<Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Contains('R20'))">
    <RevitVersion>2020</RevitVersion>
    <TargetFramework>net48</TargetFramework>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <DefineConstants>$(DefineConstants);REVIT2020</DefineConstants>
  </PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('R21'))">
		<RevitVersion>2021</RevitVersion>
    <TargetFramework>net48</TargetFramework>
		<EnableNETAnalyzers>false</EnableNETAnalyzers>
		<DefineConstants>$(DefineConstants);REVIT2021</DefineConstants>
  </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R22'))">
    <RevitVersion>2022</RevitVersion>
    <TargetFramework>net48</TargetFramework>
		<EnableNETAnalyzers>false</EnableNETAnalyzers>
		<DefineConstants>$(DefineConstants);REVIT2022</DefineConstants>
	</PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R23'))">
    <RevitVersion>2023</RevitVersion>
    <TargetFramework>net48</TargetFramework>
		<EnableNETAnalyzers>false</EnableNETAnalyzers>
		<DefineConstants>$(DefineConstants);REVIT2023</DefineConstants>
	</PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R24'))">
		<RevitVersion>2024</RevitVersion>
    <TargetFramework>net48</TargetFramework>
    <RevitApiPackageVersion>2024.0.0</RevitApiPackageVersion>
		<EnableNETAnalyzers>false</EnableNETAnalyzers>
		<DefineConstants>$(DefineConstants);REVIT2024</DefineConstants>
	</PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R25'))">
    <RevitVersion>2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RevitApiPackageVersion>2025.0.0</RevitApiPackageVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<DefineConstants>$(DefineConstants);REVIT2025</DefineConstants>
  </PropertyGroup>
    <!-- Revit 2026 runs on .NET 8, same as 2025 (verified from the local install's runtimeconfig). -->
    <PropertyGroup Condition="$(Configuration.Contains('R26'))">
    <RevitVersion>2026</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RevitApiPackageVersion>2026.0.0</RevitApiPackageVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<DefineConstants>$(DefineConstants);REVIT2026</DefineConstants>
  </PropertyGroup>
    <!-- Revit 2027 moves to .NET 10. Building this configuration requires the .NET 10 SDK. -->
    <PropertyGroup Condition="$(Configuration.Contains('R27'))">
    <RevitVersion>2027</RevitVersion>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RevitApiPackageVersion>2027.2.0</RevitApiPackageVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<DefineConstants>$(DefineConstants);REVIT2027</DefineConstants>
  </PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('Debug'))">
		<Optimize>False</Optimize>
		<OutputPath>bin\Debug\$(RevitVersion)</OutputPath>
		<DebugType>Full</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration.Contains('Release'))">
		<Optimize>True</Optimize>
		<OutputPath>bin\Release\$(RevitVersion)</OutputPath>
		<DebugType>None</DebugType>
	</PropertyGroup>

	<!--
	  Fallback for the legacy R20-R24 configurations, which predate the pinned-version
	  scheme. They target net48 and are not exercised by this repo (Revit 2025+ only),
	  but an empty package version would break evaluation outright.
	-->
	<PropertyGroup Condition="'$(RevitApiPackageVersion)' == ''">
		<RevitApiPackageVersion>2025.0.0</RevitApiPackageVersion>
	</PropertyGroup>

	<PropertyGroup>
		<Version>$(RevitVersion)</Version>
    <StartAction>Program</StartAction>
    <StartProgram>$(ProgramW6432)\Autodesk\Revit $(RevitVersion)\Revit.exe</StartProgram>
    <StartArguments>/language ENG</StartArguments>
	</PropertyGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\Blue_16.png" />
	  <EmbeddedResource Include="Resources\Blue_32.png" />
	  <EmbeddedResource Include="Resources\Green_16.png" />
	  <EmbeddedResource Include="Resources\Green_32.png" />
	  <EmbeddedResource Include="Resources\Red_16.png" />
	  <EmbeddedResource Include="Resources\Red_32.png" />
	  <EmbeddedResource Include="Resources\Yellow_16.png" />
	  <EmbeddedResource Include="Resources\Yellow_32.png" />
	  <EmbeddedResource Include="Resources\Restart_16.png" />
	  <EmbeddedResource Include="Resources\Restart_32.png" />
	  <EmbeddedResource Include="Resources\Kill_16.png" />
	  <EmbeddedResource Include="Resources\Kill_32.png" />
	  <EmbeddedResource Include="Resources\Claude_16.png" />
	  <EmbeddedResource Include="Resources\Claude_32.png" />
	</ItemGroup>
	
	<ItemGroup>
	  <PackageReference Include="System.Drawing.Common" Version="8.0.3" IncludeAssets="build; compile" PrivateAssets="All" />
	  <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="$(RevitApiPackageVersion)" IncludeAssets="build; compile" PrivateAssets="All" />
	  <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
	</ItemGroup>

	<!--
	  net48 (Revit 2024 and earlier) needs System.Text.Json from NuGet and its own copy
	  of the compiler-emitted attribute types for records and `required` members. These
	  are all in-box from .NET 8 onward, so the condition keeps R25+ untouched.
	-->
	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
	  <Compile Include="..\Shared\Net48Polyfills.cs" Link="Properties\Net48Polyfills.cs" />
	  <PackageReference Include="System.Text.Json" Version="8.0.5" />
	  <!-- Supplies the net48 reference assemblies so a build does not need Visual Studio installed. -->
	  <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\RevitMcp.Core\RevitMcp.Core.csproj" />
	</ItemGroup>
	
	<PropertyGroup>
		<RunAnalyzersDuringBuild>False</RunAnalyzersDuringBuild>
		<RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
		<Copyright>2024</Copyright>
	</PropertyGroup>

	<!--
	  Deploys the add-in into Revit's per-version Addins folder.

	  This replaces a batch PostBuildEvent that shelled out to `copy`. On .NET 8 the
	  add-in needs only 2 DLLs, because System.Text.Json and friends are in-box. The
	  net48 (Revit 2024) leg has to ship 13, since those same libraries come from
	  NuGet - which widened the window for a transient file lock (antivirus scanning
	  a freshly written DLL) to fail the copy and therefore the entire build, even
	  though every file had in fact been deployed correctly.

	  SkipUnchangedFiles avoids touching dependency DLLs that did not change between
	  builds, and Retries absorbs a lock that does occur.
	-->
	<!--
	  Set -p:SkipRevitDeploy=true to compile without deploying: on CI, where there is
	  no Revit Addins folder, and locally to verify a build while that Revit version
	  is open (Revit holds a lock on the add-in DLLs it has loaded, so the copy would
	  fail even though the compile is fine).
	-->
	<Target Name="DeployToRevitAddins" AfterTargets="Build" Condition="'$(SkipRevitDeploy)' != 'true'">
		<PropertyGroup>
			<RevitAddinsDir>$(AppData)\Autodesk\REVIT\Addins\$(RevitVersion)</RevitAddinsDir>
		</PropertyGroup>
		<ItemGroup>
			<AddinManifest Include="$(MSBuildProjectDirectory)\*.addin" />
			<AddinPayload Include="$(TargetDir)*.dll" />
		</ItemGroup>
		<Message Importance="high" Text="*** $(Configuration): deploying to $(RevitAddinsDir)" />
		<MakeDir Directories="$(RevitAddinsDir)\RevitMcp.Addin" />
		<Copy SourceFiles="@(AddinManifest)"
		      DestinationFolder="$(RevitAddinsDir)"
		      SkipUnchangedFiles="true" Retries="3" RetryDelayMilliseconds="300" />
		<Copy SourceFiles="@(AddinPayload)"
		      DestinationFolder="$(RevitAddinsDir)\RevitMcp.Addin"
		      SkipUnchangedFiles="true" Retries="3" RetryDelayMilliseconds="300" />
	</Target>
	
	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Properties\Settings.Designer.cs">
	    <DesignTimeSharedInput>True</DesignTimeSharedInput>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Settings.settings</DependentUpon>
	  </Compile>
	</ItemGroup>
	
	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>
	
	<ItemGroup>
	  <None Update="Properties\Settings.settings">
	    <Generator>SettingsSingleFileGenerator</Generator>
	    <LastGenOutput>Settings.Designer.cs</LastGenOutput>
	  </None>
	  <None Update="RegisterAddin.addin">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
  
</Project>
